*.pt
*.pth
*.ckpt
*.safetensors
*.gguf
*.onnx
*.h5
*.pkl
*.npy
*.npz
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.mp4
*.avi
*.mov

# data / eval artifacts / outputs
data/
playground/data/
**/answers/
results/
outputs/
output/
logs/
*.log
wandb/
runs/
eval_results/
checkpoints/
ckpt*/
*.jsonl

