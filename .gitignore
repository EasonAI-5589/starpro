*.pre_*
*.bak
*.bak_*
_duet_*.py

# env
.env
*.pem
*.key
id_rsa*

# experiment output dirs / logs (broader)
results*/
experiments*/
logs*/
*.fulllog
*.output
*.out
merge.jsonl
